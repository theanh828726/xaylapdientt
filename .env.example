# Sao chép thành .env rồi đổi giá trị. KHÔNG commit .env.
POSTGRES_DB=tuyenso
POSTGRES_USER=tuyenso
POSTGRES_PASSWORD=doi-mat-khau-nay
DATABASE_URL=postgresql+asyncpg://tuyenso:doi-mat-khau-nay@db:5432/tuyenso
# Chuỗi ngẫu nhiên >= 32 ký tự: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
ENV=dev
COOKIE_SECURE=false
# Chỉ dùng cho `python -m app.seed_demo` (dữ liệu demo). Tài khoản demo: <vai-tro>@demo.tuyenso.local
SEED_DEMO_PASSWORD=DemoTuyenSo#2026

# Lưu trữ ảnh/biên bản (MinIO). Production: tạo access key riêng thay vì dùng tài khoản root.
MINIO_ROOT_USER=tuyenso-minio
MINIO_ROOT_PASSWORD=doi-mat-khau-nay
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=tuyenso
MINIO_SECURE=false
